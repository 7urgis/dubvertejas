  {
    "idx": 128,
    "start_sec": 1079.19,
    "end_sec": 1082.95,
    "timing": "00:17:59,190 --> 00:18:02,950",
    "en": "He should have overcome the Super Saiyan wall long ago.",
    "lt": "Jis jau seniai turėjo peržengti Super Sajano ribą."
  },
  {
    "idx": 129,
    "start_sec": 1089.11,
    "end_sec": 1091.43,
    "timing": "00:18:09,110 --> 00:18:11,430",
    "en": "Please hurry, Vegeta.",
    "lt": "Prašau, paskubėk, Vedžitai."
  },
  {
    "idx": 130,
    "start_sec": 1091.43,
    "end_sec": 1093.78,
    "timing": "00:18:11,430 --> 00:18:13,780",
    "en": "What will happen cannot be undone!",
    "lt": "Jei tai įvyks, kelio atgal nebebus!"
  },
  {
    "idx": 131,
    "start_sec": 1243.02,
    "end_sec": 1244.56,
    "timing": "00:20:43,020 --> 00:20:44,560",
    "en": "Our powers may be evenly matched,",
    "lt": "Mūsų jėgos gal ir apylygės,"
  },
  {
    "idx": 132,
    "start_sec": 1244.56,
    "end_sec": 1247.49,
    "timing": "00:20:44,560 --> 00:20:47,490",
    "en": "but there appears to be a gap widening between our stamina.",
    "lt": "tačiau mūsų ištvermė akivaizdžiai skiriasi."
  },
  {
    "idx": 133,
    "start_sec": 1248.65,
    "end_sec": 1251.77,
    "timing": "00:20:48,650 --> 00:20:51,770",
    "en": "My energy will never drop!",
    "lt": "Mano energija niekada nesibaigs!"
  },
  {
    "idx": 134,
    "start_sec": 1309.08,
    "end_sec": 1311.58,
    "timing": "00:21:49,080 --> 00:21:51,580",
    "en": "C-Cell!",
    "lt": "S-Selas!"
  },
  {
    "idx": 135,
    "start_sec": 1315.26,
    "end_sec": 1317.61,
    "timing": "00:21:55,260 --> 00:21:57,610",
    "en": "At last, Cell has appeared!",
    "lt": "Pagaliau Selas pasirodė!"
  },
  {
    "idx": 136,
    "start_sec": 1340.66,
    "end_sec": 1345.95,
    "timing": "00:22:20,660 --> 00:22:25,950",
    "en": "Has the time at last come for him to merge with No.17 and No.18?",
    "lt": "Ar pagaliau atėjo laikas jam susijungti su robotu numeris septyniolika ir numeriu aštuoniolika?"
  },
  {
    "idx": 172,
    "start_sec": 1450.56,
    "end_sec": 1452.1,
    "timing": "00:24:10,560 --> 00:24:12,100",
    "en": "Heya! I'm Goku!",
    "lt": "Sveiki! Aš esu Gokas!"
  },
  {
    "idx": 173,
    "start_sec": 1452.1,
    "end_sec": 1453.97,
    "timing": "00:24:12,100 --> 00:24:13,970",
    "en": "Damn, what a ki.",
    "lt": "Velniava, kokia galinga energija."
  },
  {
    "idx": 174,
    "start_sec": 1453.97,
    "end_sec": 1456.58,
    "timing": "00:24:13,970 --> 00:24:16,580",
    "en": "Cell has raised his power like crazy.",
    "lt": "Selas beprotiškai padidino savo galią."
  },
  {
    "idx": 175,
    "start_sec": 1456.58,
    "end_sec": 1459.32,
    "timing": "00:24:16,580 --> 00:24:19,320",
    "en": "Stop, Piccolo! Not even you're a match for him!",
    "lt": "Sustok, Pikolai! Net tu jam neprilygsti!"
  },
  {
    "idx": 176,
    "start_sec": 1459.32,
    "end_sec": 1460.48,
    "timing": "00:24:19,320 --> 00:24:20,480",
    "en": "Curse you, Cell!",
    "lt": "Būk prakeiktas, Selai!"
  },
  {
    "idx": 177,
    "start_sec": 1460.48,
    "end_sec": 1462.86,
    "timing": "00:24:20,480 --> 00:24:22,860",
    "en": "Just how many people have you sacrificed?!",
    "lt": "Kiek žmonių tu jau paaukojai?!"
  },
  {
    "idx": 178,
    "start_sec": 1462.86,
    "end_sec": 1464.94,
    "timing": "00:24:22,860 --> 00:24:24,940",
    "en": "I won't let you reach your perfect form!",
    "lt": "Aš neleisiu tau pasiekti tobulos formos!"
  },
  {
    "idx": 179,
    "start_sec": 1465.28,
    "end_sec": 1466.95,
    "timing": "00:24:25,280 --> 00:24:26,950",
    "en": "Next time on Dragon Ball Z:",
    "lt": "Kitoje Drakonų Kovos Z serijoje:"
  },
  {
    "idx": 180,
    "start_sec": 1466.95,
    "end_sec": 1470.62,
    "timing": "00:24:26,950 --> 00:24:30,620",
    "en": "\"The Suicide Counterattack Proves Ineffective! Piccolo's Flame Burns Out!!\"",
    "lt": "„Savižudiška ataka bejėgė! Pikolo liepsna gęsta!!“"
  },
  {
    "idx": 181,
    "start_sec": 1470.62,
    "end_sec": 1473.12,
    "timing": "00:24:30,620 --> 00:24:33,120",
    "en": "Oh, no! Piccolo-san's ki is fading out!",
    "lt": "O ne! Pikolo energija silpsta!"
  }
]